{
  "name": "haven-desktop",
  "version": "1.4.30",
  "description": "Haven Desktop — Private chat, reimagined for your desktop",
  "main": "src/main/main.js",
  "author": {
    "name": "Haven Contributors",
    "email": "help.havenapp@gmail.com"
  },
  "license": "AGPL-3.0",
  "homepage": "https://ancsemi.github.io/Haven/",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "i18n:check": "node scripts/check-i18n.js && node scripts/check-language-sync.js",
    "build": "npm run i18n:check && npm run build:native && electron-builder",
    "build:win": "npm run i18n:check && npm run build:native && electron-builder --win",
    "build:linux": "npm run i18n:check && npm run build:native && electron-builder --linux",
    "build:native": "node ./node_modules/node-gyp/bin/node-gyp.js rebuild --directory=native",
    "rebuild:electron": "electron-builder install-app-deps && npm run build:native",
    "postinstall": "electron-builder install-app-deps || echo electron-rebuild skipped"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "node-addon-api": "^8.3.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^42.10.1",
    "electron-builder": "^26.15.7",
    "node-gyp": "^10.3.1"
  }
}
